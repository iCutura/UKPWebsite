---
import StoreBadge from './StoreBadge.astro';
/**
 * The pair of store badges, for anywhere on the site that points at the apps. There is no light or
 * dark variant any more: the badges are Apple's and Google's artwork and they look the same on
 * every surface, which is the point of them.
 */
---
<div class="cluster gap-1">
  <StoreBadge store="ios" />
  <StoreBadge store="android" />
</div>
