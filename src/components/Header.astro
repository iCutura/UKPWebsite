---
import Icon from './Icon.astro';
import { SITE } from '../config';
interface Props { onArt?: boolean }
const { onArt = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---
<header class:list={['header', { 'header--on-art': onArt }]} data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Urbana kviz priča, naslovna">
      <img class="brand-mark" src="/img/brand/mascot-white-96.webp" width="40" height="40" alt="" />
      <span class="brand-text"><span class="brand-line">Urbana</span><span class="brand-line">kviz priča</span></span>
    </a>
    <nav class="nav-desktop" aria-label="Glavna navigacija">
      {SITE.nav.map(n => <a href={n.href} class:list={['nav-link', { 'is-active': isActive(n.href) }]}>{n.label}</a>)}
    </nav>
    <div class="header-actions">
      <a href="/lokacije/" class="btn btn-accent btn-sm hide-mobile" data-magnetic="10">Pronađi kviz <Icon name="arrow-right" size={18} /></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Izbornik" data-nav-toggle>
        <span class="nav-toggle-open"><Icon name="menu" size={24} /></span>
        <span class="nav-toggle-close"><Icon name="x" size={24} /></span>
      </button>
    </div>
  </div>
  <div id="nav-panel" class="nav-panel" data-nav-panel hidden>
    <div class="container nav-panel-inner">
      <nav aria-label="Navigacija" class="nav-panel-links">
        {SITE.nav.map((n, i) => <a href={n.href} class:list={['nav-panel-link', { 'is-active': isActive(n.href) }]} data-nav-item style={`--i:${i}`}><span class="num nav-panel-index">0{i + 1}</span>{n.label}</a>)}
      </nav>
      <div class="nav-panel-foot" data-nav-item>
        <a href="/lokacije/" class="btn btn-accent btn-lg btn-block">Pronađi kviz u svom gradu <Icon name="arrow-right" /></a>
        <div class="cluster gap-2 mt-3">
          <a class="btn btn-ghost btn-sm" href={SITE.apps.ios} rel="noopener" target="_blank"><Icon name="apple" size={18} /> App Store</a>
          <a class="btn btn-ghost btn-sm" href={SITE.apps.android} rel="noopener" target="_blank"><Icon name="play" size={18} /> Google Play</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .header { position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--header-h); transition: transform .45s var(--ease-out), background-color .35s, backdrop-filter .35s, box-shadow .35s; color: var(--ink); }
  .header.is-hidden { transform: translateY(-110%); }
  .header.is-scrolled { background: rgb(255 247 240 / .62); backdrop-filter: blur(16px) saturate(1.3); -webkit-backdrop-filter: blur(16px) saturate(1.3); box-shadow: 0 1px 0 rgb(42 26 20 / .08); }
  .header--on-art:not(.is-scrolled) { color: var(--on-dark); }
  .header-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: inherit; text-decoration: none !important; }
  .brand-mark { width: 40px; height: 40px; border-radius: 12px; background: var(--dark); padding: 5px; box-shadow: var(--sh-subtle); }
  .header--on-art:not(.is-scrolled) .brand-mark { background: rgb(255 255 255 / .16); backdrop-filter: blur(8px); }
  .brand-text { display: flex; flex-direction: column; font-weight: 800; font-size: .95rem; line-height: 1; letter-spacing: -.02em; text-transform: uppercase; }
  .brand-line + .brand-line { margin-top: 3px; font-weight: 600; opacity: .8; font-size: .78rem; letter-spacing: .02em; }
  .nav-desktop { display: none; gap: 4px; }
  .nav-link { position: relative; padding: 10px 14px; border-radius: var(--r-pill); font-weight: 600; font-size: .95rem; color: inherit; text-decoration: none !important; transition: background-color .25s; }
  .nav-link:hover { background: rgb(42 26 20 / .07); }
  .header--on-art:not(.is-scrolled) .nav-link:hover { background: rgb(255 255 255 / .14); }
  .nav-link.is-active::after { content: ""; position: absolute; left: 14px; right: 14px; bottom: 5px; height: 2px; border-radius: 2px; background: var(--accent); }
  .header--on-art:not(.is-scrolled) .nav-link.is-active::after { background: var(--on-dark); }
  .header-actions { display: flex; align-items: center; gap: 12px; }
  .nav-toggle { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; color: inherit; background: rgb(42 26 20 / .07); }
  .header--on-art:not(.is-scrolled) .nav-toggle { background: rgb(255 255 255 / .14); }
  .nav-toggle > span { grid-area: 1 / 1; display: grid; transition: opacity .2s, transform .3s var(--ease-out); }
  .nav-toggle-close { opacity: 0; transform: rotate(-90deg); }
  :global(body.nav-open) .nav-toggle-open { opacity: 0; transform: rotate(90deg); }
  :global(body.nav-open) .nav-toggle-close { opacity: 1; transform: none; }
  :global(body.nav-open) .header { color: var(--on-dark) !important; background: transparent !important; box-shadow: none !important; backdrop-filter: none !important; }
  :global(body.nav-open) .brand-mark, :global(body.nav-open) .nav-toggle { background: rgb(255 255 255 / .12) !important; }
  :global(body.nav-open) { overflow: hidden; }
  .nav-panel { position: fixed; inset: 0; z-index: -1; background: linear-gradient(160deg, var(--night-0), var(--night-1) 60%, var(--night-2)); color: var(--on-dark); overflow-y: auto; padding-top: calc(var(--header-h) + 24px); padding-bottom: 32px; }
  .nav-panel[hidden] { display: none; }
  .nav-panel-inner { min-height: 100%; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; }
  .nav-panel-links { display: flex; flex-direction: column; }
  .nav-panel-link { display: flex; align-items: baseline; gap: 16px; padding: 14px 0; font-size: clamp(2rem, 8vw, 3.25rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; color: var(--on-dark); text-decoration: none !important; border-bottom: 1px solid var(--dark-divider); }
  .nav-panel-link.is-active { color: var(--accent-soft); }
  .nav-panel-index { font-size: .8rem; color: var(--on-dark-lo); letter-spacing: .1em; }
  @media (min-width: 1000px) {
    .nav-desktop { display: flex; }
    .nav-toggle { display: none; }
    .nav-panel { display: none !important; }
  }
</style>
