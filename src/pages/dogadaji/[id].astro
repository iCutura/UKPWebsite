---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getEvents, getLocation, eventsForLocation, type EventItem } from '../../lib/data';
import { eventHeaderHTML, eventFactsHTML, registrationPanelHTML, eventJsonLd, eventActionsHTML, textToHTML } from '../../lib/detail';
import { eventCardHTML } from '../../lib/render';
import { longDate, parseApiDate, time, fee } from '../../lib/format';
import { SITE } from '../../config';

export function getStaticPaths() {
  return getEvents().map(e => ({ params: { id: String(e.id) }, props: { e } }));
}
const { e } = Astro.props as { e: EventItem };
const loc = getLocation(e.locationId);
const others = eventsForLocation(e.locationId).filter(x => x.id !== e.id).slice(0, 3);
const d = parseApiDate(e.date);
const feeTxt = fee(e.feeType, e.feeAmount, e.feeCurrency);
const title = `${e.name || 'Pub kviz'} · ${e.venueName}, ${longDate(d)}`;
const desc = `${e.name || 'Pub kviz'} u ${e.venueName}, ${e.city.name}: ${longDate(d)} u ${time(e.startTime)}. ${feeTxt ?? ''} Prijavi svoju ekipu.`.trim();
---
<Base title={title} description={desc} image={e.image?.full}>
  <script type="application/ld+json" set:html={eventJsonLd(e)} />
  <section class="page-head">
    <div class="container">
      <nav class="crumbs" aria-label="Putanja" data-reveal><a href="/dogadaji/">Događaji</a><Icon name="arrow-right" /><a href={e.locationUrl ?? '/lokacije/'}>{e.venueName}</a></nav>
      <div class="evd mt-4" data-event-page={e.id} data-location-id={e.locationId} data-location-url={e.locationUrl ?? '/lokacije/'}>
        <div class="evd-main" data-reveal>
          <Fragment set:html={eventHeaderHTML(e)} />
          <Fragment set:html={eventFactsHTML(e)} />
          <div class="prose mt-4" data-about hidden={!loc?.description} set:html={loc?.description ? textToHTML(loc.description) : ''} />
          {/* Shared with the 404 page's fallback, which draws this same page for an event created
              after the last deploy - it used to lose these three buttons entirely. */}
          <Fragment set:html={eventActionsHTML(e, title)} />
        </div>
        <aside class="evd-side" data-reveal>
          <Fragment set:html={registrationPanelHTML(e, SITE.registrationEnabled)} />
        </aside>
      </div>
    </div>
  </section>
  {others.length > 0 && (
    <section class="section-tight">
      <div class="container">
        <SectionHead eyebrow="Ista lokacija" title="Ostali termini" href={e.locationUrl ?? '/lokacije/'} linkLabel="O lokaciji" />
        <div class="grid grid-3" set:html={others.map(x => eventCardHTML(x, { showLocation: false })).join('')} />
      </div>
    </section>
  )}
</Base>
<!-- The share button is bound in scripts/live.ts, which runs on every page: the 404 fallback
     renders this same button and would otherwise ship a dead control. -->
