---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import AppBadges from '../../components/AppBadges.astro';
import { getNews, type NewsItem } from '../../lib/data';
import { newsArticleHTML } from '../../lib/detail';
import { newsCardHTML } from '../../lib/render';

export function getStaticPaths() { return getNews().map(n => ({ params: { id: String(n.id) }, props: { n } })); }
const { n } = Astro.props as { n: NewsItem };
const more = getNews().filter(x => x.id !== n.id).slice(0, 3);
---
<Base title={n.title} description={n.summary} image={n.image?.full}>
  <section class="page-head">
    <div class="container">
      <nav class="crumbs article" aria-label="Putanja" data-reveal><a href="/novosti/">Novosti</a><Icon name="arrow-right" /><span>{n.title.slice(0, 40)}{n.title.length > 40 ? '…' : ''}</span></nav>
      <div class="mt-4" data-reveal><Fragment set:html={newsArticleHTML(n)} /></div>
      <div class="article mt-6" data-reveal>
        <div class="card-dark card-pad">
          <span class="eyebrow">UKP Quiz aplikacija</span>
          <h2 class="h3">Novosti stižu i kao obavijest na mobitel.</h2>
          <p class="mt-2 muted">Zaprati svoje lokacije u aplikaciji i saznaj prvi za nove termine, finala i tematske kvizove.</p>
          <div class="mt-3"><AppBadges light /></div>
        </div>
      </div>
    </div>
  </section>
  {more.length > 0 && (
    <section class="section-tight">
      <div class="container">
        <SectionHead eyebrow="Još novosti" title="Nastavi čitati" href="/novosti/" linkLabel="Sve novosti" />
        <div class="grid grid-3" set:html={more.map(x => newsCardHTML(x)).join('')} />
      </div>
    </section>
  )}
</Base>
