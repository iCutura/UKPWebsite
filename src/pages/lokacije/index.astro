---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getLocations, getCities } from '../../lib/data';
import { locationCardHTML } from '../../lib/render';
import LocationsMap from '../../components/LocationsMap.astro';
import NearbyControls from '../../components/NearbyControls.astro';

// getLocations() already orders these: locations with a scheduled quiz first, soonest first, then by city.
const locations = getLocations();
const cities = getCities();
const countries = [...new Set(cities.map(c => c.country).filter(Boolean))] as string[];
const top = [...cities].sort((a, b) => b.locations - a.locations || a.name.localeCompare(b.name, 'hr')).slice(0, 8);
const withEvents = locations.filter(l => l.upcomingCount > 0).length;
const coords = Object.fromEntries(locations.map(l => [l.id, { lat: l.lat, lng: l.lng }]));
---
<Base title="Lokacije" description={`Pub kvizovi Urbane kviz priče na ${locations.length} lokacija u ${cities.length} gradova Hrvatske i Bosne i Hercegovine. Pronađi kviz u svom gradu.`}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow" data-reveal>Lokacije</span>
      <h1 data-reveal>Pronađi kviz u svom gradu.</h1>
      <p class="lead mt-3" data-reveal>{locations.length} lokacija u {cities.length} gradova. Svaka lokacija je jedan kvizaški termin: isti kafić može imati kviz i ponedjeljkom i srijedom.</p>
    </div>
  </section>

  <section class="filter-bar" data-filter-bar>
    <div class="container filter-inner">
      <label class="search">
        <Icon name="search" size={20} />
        <input type="search" class="input" placeholder="Grad ili kafić" autocomplete="off" data-filter-q aria-label="Pretraži grad ili kafić" />
      </label>
      <div class="filter-chips" role="group" aria-label="Filtri">
        <button type="button" class="chip fchip is-active" data-filter-country="" aria-pressed="true">Sve</button>
        {countries.map(c => <button type="button" class="chip fchip" data-filter-country={c} aria-pressed="false">{c === 'Bosna i Hercegovina' ? 'BiH' : c}</button>)}
        <span class="fsep" aria-hidden="true"></span>
        <button type="button" class="chip fchip" data-filter-upcoming aria-pressed="false"><Icon name="calendar" size={14} /> Samo sa zakazanim terminom</button>
      </div>
      <div class="filter-tools">
        <div class="view-switch" role="group" aria-label="Prikaz">
          <button type="button" class="view-btn is-active" data-view="list" aria-pressed="true">Popis</button>
          <button type="button" class="view-btn" data-view="map" aria-pressed="false">Karta</button>
        </div>
        <NearbyControls grid="[data-filter-grid]" item="data-location-id" coords={coords} />
      </div>
      <div class="filter-cities" aria-label="Najveći gradovi">
        {top.map(c => <button type="button" class="chip fchip" data-filter-city={c.name} aria-pressed="false">{c.name} <span class="num fcount">{c.locations}</span></button>)}
        <label class="city-select">
          <span class="sr-only">Svi gradovi</span>
          <select class="input" data-filter-select>
            <option value="">Svi gradovi…</option>
            {cities.map(c => <option value={c.name}>{c.name} ({c.locations})</option>)}
          </select>
        </label>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <p class="results-line muted" aria-live="polite"><span class="num" data-filter-count>{locations.length}</span> lokacija · <span class="num">{withEvents}</span> sa zakazanim terminom</p>
      <div data-view-panel="list">
        <div class="grid grid-3 loc-grid" data-live="locations" data-filter-grid set:html={locations.map(l => locationCardHTML(l)).join('')} />
        <div class="empty mt-4" data-filter-empty hidden>Nema lokacija za taj filter. Probaj drugi grad ili nas <a href="/kontakt/">pitaj kad stižemo k tebi</a>.</div>
      </div>
      <div data-view-panel="map" hidden>
        <LocationsMap locations={locations} />
      </div>
    </div>
  </section>
</Base>

<script>
  function init() {
    const bar = document.querySelector<HTMLElement>('[data-filter-bar]')!; if (!bar || bar.dataset.bound) return; bar.dataset.bound = '1';
    const q = bar.querySelector<HTMLInputElement>('[data-filter-q]')!;
    const select = bar.querySelector<HTMLSelectElement>('[data-filter-select]')!;
    const grid = document.querySelector<HTMLElement>('[data-filter-grid]')!;
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]')!;
    const count = document.querySelector<HTMLElement>('[data-filter-count]')!;
    const state = { q: '', country: '', city: '', upcoming: false };
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').toLowerCase();
    const params = new URLSearchParams(location.search);
    if (params.get('grad')) { state.city = params.get('grad')!; select.value = state.city; }
    let locations: any[] | null = null;
    fetch('/data/locations.json', { cache: 'no-cache' }).then(r => r.json()).then(d => { locations = d; apply(); }).catch(() => {});

    function apply() {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-location-id]'));
      const byId = new Map((locations || []).map((l: any) => [String(l.id), l]));
      let shown = 0; const nq = norm(state.q.trim());
      for (const c of cards) {
        const l = byId.get(c.dataset.locationId!);
        const city = c.dataset.city || l?.city?.name || '';
        const text = norm(c.textContent || '');
        let ok = true;
        if (nq && !text.includes(nq)) ok = false;
        if (state.country && l && l.city?.country !== state.country) ok = false;
        if (state.city && city !== state.city) ok = false;
        if (state.upcoming && l && !(l.upcomingCount > 0)) ok = false;
        c.hidden = !ok; if (ok) shown++;
      }
      count.textContent = String(shown); empty.hidden = shown > 0;
      bar.querySelectorAll<HTMLElement>('[data-filter-country]').forEach(b => { const on = (b.dataset.filterCountry || '') === state.country; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', String(on)); });
      bar.querySelectorAll<HTMLElement>('[data-filter-city]').forEach(b => { const on = b.dataset.filterCity === state.city; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', String(on)); });
      const up = bar.querySelector<HTMLElement>('[data-filter-upcoming]')!; up.classList.toggle('is-active', state.upcoming); up.setAttribute('aria-pressed', String(state.upcoming));
      const url = new URL(location.href); state.city ? url.searchParams.set('grad', state.city) : url.searchParams.delete('grad'); history.replaceState(null, '', url);
    }
    q.addEventListener('input', () => { state.q = q.value; apply(); });
    select.addEventListener('change', () => { state.city = select.value; apply(); });
    bar.querySelectorAll<HTMLElement>('[data-filter-country]').forEach(b => b.addEventListener('click', () => { state.country = b.dataset.filterCountry || ''; apply(); }));
    bar.querySelectorAll<HTMLElement>('[data-filter-city]').forEach(b => b.addEventListener('click', () => { state.city = state.city === b.dataset.filterCity ? '' : b.dataset.filterCity!; select.value = state.city; apply(); }));
    bar.querySelector('[data-filter-upcoming]')!.addEventListener('click', () => { state.upcoming = !state.upcoming; apply(); });
    grid.addEventListener('ukp:live', apply);
    apply();

    // List or map. The choice sticks for the visit, because someone who prefers the map
    // usually prefers it on the way back too.
    const panels = document.querySelectorAll<HTMLElement>('[data-view-panel]');
    const setView = (view: string) => {
      panels.forEach(p => { p.hidden = p.dataset.viewPanel !== view; });
      bar.querySelectorAll<HTMLElement>('[data-view]').forEach(b => {
        const on = b.dataset.view === view;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      try { sessionStorage.setItem('ukp-lokacije-view', view); } catch {}
    };
    bar.querySelectorAll<HTMLElement>('[data-view]').forEach(b => b.addEventListener('click', () => setView(b.dataset.view!)));
    try {
      const saved = sessionStorage.getItem('ukp-lokacije-view');
      if (saved === 'map') setView('map');
    } catch {}
  }
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  .filter-bar { position: static; z-index: 30; padding: 12px 0; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); border-bottom: 1px solid rgb(var(--rule) / .09); }
  .filter-inner { display: flex; flex-direction: column; gap: 10px; }
  .search { position: relative; display: block; max-width: 520px; }
  .search svg { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--ink-md); pointer-events: none; }
  .search .input { padding-left: 46px; min-height: 48px; }
  .filter-chips, .filter-cities { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .filter-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  @media (max-width: 759px) {
    .filter-bar { padding: 8px 0; }
    /* One swipeable row each, instead of two wrapped rows and a stacked tool column. */
    .filter-chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding-bottom: 2px; }
    .filter-chips::-webkit-scrollbar { display: none; }
    .filter-chips .fchip { flex: 0 0 auto; }
    .filter-tools { gap: 8px 10px; }
    .filter-tools .nearby { flex: 1 1 auto; min-width: 0; }
    /* The privacy line gets its own full-width line so it stays one line, not three. */
    .filter-tools .nearby-note { flex-basis: 100%; }
  }
  .view-switch { display: inline-flex; padding: 3px; border-radius: var(--r-pill); background: rgb(var(--rule) / .06); border: 1px solid rgb(var(--rule) / .08); }
  /* 38px keeps the switch comfortable to hit on a phone without making it loud on desktop. */
  .view-btn { min-height: 38px; padding: 0 16px; border-radius: var(--r-pill); font-size: .8125rem; font-weight: 700; color: var(--ink-md); transition: background-color .2s, color .2s; }
  .view-btn.is-active { background: var(--dark); color: var(--on-dark); }
  /* On a phone the city shortcuts otherwise stack into five rows of chrome before the first location. */
  @media (max-width: 759px) {
    .filter-cities { flex-wrap: nowrap; overflow-x: auto; min-width: 0; max-width: 100vw; scrollbar-width: none; padding-block: 2px;
      margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 16px, #000 calc(100% - 24px), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 16px, #000 calc(100% - 24px), transparent); }
    .filter-cities::-webkit-scrollbar { display: none; }
    .filter-cities > * { flex: none; }
    .filter-chips { row-gap: 8px; }
  }
  .fchip { min-height: 36px; cursor: pointer; transition: background-color .25s, color .25s, border-color .25s; }
  .fchip:hover { background: rgb(var(--rule) / .09); }
  .fchip.is-active { background: var(--dark); color: var(--on-dark); border-color: transparent; }
  .fchip.is-active .fcount { color: var(--accent-soft); }
  .fcount { font-size: .75rem; color: var(--ink-md); }
  .fsep { width: 1px; height: 22px; background: rgb(var(--rule) / .15); margin: 0 4px; }
  .city-select .input { min-height: 36px; padding: 0 12px; border-radius: var(--r-pill); font-size: .8125rem; font-weight: 600; width: auto; background: rgb(var(--rule) / .045); border-color: rgb(var(--rule) / .09); }
  .results-line { font-size: var(--fs-small); margin-bottom: 20px; }
  .loc-grid { align-items: stretch; }
  @media (min-width: 760px) { .filter-bar { position: sticky; top: 0; } .filter-tools { grid-area: tools; } .filter-inner { display: grid; grid-template-columns: minmax(240px, 420px) 1fr; grid-template-areas: "search chips" "tools tools" "cities cities"; align-items: center; gap: 10px 20px; } .search { grid-area: search; } .filter-chips { grid-area: chips; } .filter-cities { grid-area: cities; } }
</style>
