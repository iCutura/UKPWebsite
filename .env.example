# Copy to .env and fill in from the password manager. .env is gitignored and must stay that way:
# this repository is public.

# SiteGround FTP for the kvizovi.hr hosting account (deploy target, and the legacy WordPress site).
# Connect with explicit FTPS on port 21; plain FTP would send the password in the clear.
LEGACY_FTP_HOST=''
LEGACY_FTP_PORT='21'
LEGACY_FTP_USER=''
LEGACY_FTP_PASS=''
LEGACY_SITE_URL='https://kvizovi.hr'

# MySQL on the same SiteGround account. Only needed for one-off work against the old WordPress
# database; the new site does not use a database. Remote access requires the client IP to be
# whitelisted in Site Tools first.
SG_MYSQL_HOST=''
SG_MYSQL_PORT='3306'
SG_MYSQL_USER=''
SG_MYSQL_PASS=''
SG_MYSQL_DB_LEGACY=''
SG_MYSQL_DB_NEW=''

# PubQuiz API. The key is the production ApiKeys:PublicWebsite entry and is used at build time and
# by the server-side proxy only; it is never shipped to the browser.
UKP_API_BASE='https://api.injeel-it.hr'
UKP_API_KEY=''
